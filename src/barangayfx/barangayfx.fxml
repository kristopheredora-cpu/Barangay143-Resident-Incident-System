<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="barangayfx.Controller"
      styleClass="root-pane">

    <!-- TOP BAR -->
    <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12"
          minHeight="66" maxHeight="66">
        <padding><Insets top="0" right="24" bottom="0" left="24"/></padding>
        <Label text="Barangay 143" styleClass="topbar-brgy"/>
        <Label text="·" styleClass="topbar-sep"/>
        <Label text="Resident &amp; Incident Reporting System" styleClass="topbar-title"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="topbar-user-pill">
            <Label styleClass="topbar-avatar-circle" text="A"/>
            <VBox spacing="1">
                <Label fx:id="lblCurrentUser" text="Admin" styleClass="topbar-user-name"/>
                <Label text="Administrator" styleClass="topbar-user-role"/>
            </VBox>
        </HBox>
    </HBox>

    <!-- BODY -->
    <HBox VBox.vgrow="ALWAYS">

        <!-- SIDEBAR -->
        <VBox styleClass="sidebar" minWidth="240" prefWidth="240" maxWidth="240">

            <HBox styleClass="sidebar-logo-area" alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                <ImageView fitWidth="46" fitHeight="46" preserveRatio="true" smooth="true">
                    <image><Image url="@logo.png"/></image>
                </ImageView>
                <VBox spacing="2">
                    <Label text="BARANGAY 143" styleClass="sidebar-logo-name"/>
                    <Label text="Olongapo City" styleClass="sidebar-logo-sub"/>
                </VBox>
            </HBox>

            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <padding><Insets top="16" right="12" bottom="12" left="12"/></padding>

                <Label text="MAIN" styleClass="nav-section-label"/>

                <Button fx:id="btnNavDashboard" styleClass="nav-item"
                        maxWidth="Infinity" onAction="#showDashboard">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT"
                              style="-fx-padding:12 14 12 14;-fx-min-width:216;">
                            <Label text="⊞" styleClass="nav-icon"/>
                            <Label text="Dashboard" styleClass="nav-label"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnNavResidents" styleClass="nav-item"
                        maxWidth="Infinity" onAction="#showResidents">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT"
                              style="-fx-padding:12 14 12 14;-fx-min-width:216;">
                            <Label text="👤" styleClass="nav-icon"/>
                            <Label text="Residents" styleClass="nav-label"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnNavIncidents" styleClass="nav-item"
                        maxWidth="Infinity" onAction="#showIncidents">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT"
                              style="-fx-padding:12 14 12 14;-fx-min-width:216;">
                            <Label text="⚠" styleClass="nav-icon"/>
                            <Label text="Incidents" styleClass="nav-label"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnNavInventory" styleClass="nav-item"
                        maxWidth="Infinity" onAction="#showInventory">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT"
                              style="-fx-padding:12 14 12 14;-fx-min-width:216;">
                            <Label text="📦" styleClass="nav-icon"/>
                            <Label text="Inventory" styleClass="nav-label"/>
                        </HBox>
                    </graphic>
                </Button>

                <Label text="SYSTEM" styleClass="nav-section-label">
                    <VBox.margin><Insets top="18"/></VBox.margin>
                </Label>

                <Button fx:id="btnNavSettings" styleClass="nav-item"
                        maxWidth="Infinity" onAction="#showSettings">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT"
                              style="-fx-padding:12 14 12 14;-fx-min-width:216;">
                            <Label text="⚙" styleClass="nav-icon"/>
                            <Label text="Settings" styleClass="nav-label"/>
                        </HBox>
                    </graphic>
                </Button>
            </VBox>

            <VBox styleClass="sidebar-footer">
                <padding><Insets top="10" right="12" bottom="20" left="12"/></padding>
                <Button styleClass="sidebar-logout-btn" maxWidth="Infinity"
                        onAction="#handleLogout">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT"
                              style="-fx-padding:12 14 12 14;-fx-min-width:216;">
                            <Label text="⏻" styleClass="nav-icon"/>
                            <Label text="Log out" styleClass="nav-label"/>
                        </HBox>
                    </graphic>
                </Button>
            </VBox>

        </VBox>

        <!-- CONTENT -->
        <StackPane fx:id="viewStack" styleClass="content-area" HBox.hgrow="ALWAYS">

            <!-- DASHBOARD -->
            <VBox fx:id="viewDashboard" spacing="20" visible="true" managed="true">
                <padding><Insets top="28" right="28" bottom="32" left="28"/></padding>

                <HBox alignment="CENTER_LEFT">
                    <VBox HBox.hgrow="ALWAYS" spacing="4">
                        <Label text="Good Day, Admin! 👋" styleClass="page-title"/>
                        <Label text="Here's what's happening in Barangay 143 today."
                               styleClass="page-subtitle"/>
                    </VBox>
                    <HBox styleClass="date-chip" alignment="CENTER_LEFT" spacing="8">
                        <Label text="📅" styleClass="date-chip-icon"/>
                        <Label fx:id="lblCurrentDate" text="—" styleClass="date-chip-text"/>
                    </HBox>
                </HBox>

                <!-- METRIC CARDS -->
                <HBox spacing="16">
                    <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"
                          style="-fx-border-color:#BBDEFB;">
                        <padding><Insets top="22" right="22" bottom="20" left="22"/></padding>
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color:#DBEAFE;-fx-background-radius:14;
                                              -fx-min-width:62;-fx-min-height:62;-fx-max-width:62;-fx-max-height:62;">
                                <Label text="👥" style="-fx-font-size:30px;"/>
                            </StackPane>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Total Residents" styleClass="metric-label"/>
                                <Label fx:id="metricResidents" text="—" styleClass="metric-value"/>
                                <Label fx:id="metricResidentsSub" text=""
                                       style="-fx-font-size:12px;-fx-text-fill:#1565C0;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"
                          style="-fx-border-color:#FFCDD2;">
                        <padding><Insets top="22" right="22" bottom="20" left="22"/></padding>
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color:#FEE2E2;-fx-background-radius:14;
                                              -fx-min-width:62;-fx-min-height:62;-fx-max-width:62;-fx-max-height:62;">
                                <Label text="⚠" style="-fx-font-size:30px;"/>
                            </StackPane>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Open Incidents" styleClass="metric-label"/>
                                <Label fx:id="metricOpenIncidents" text="—"
                                       style="-fx-font-size:42px;-fx-font-weight:bold;-fx-text-fill:#C62828;"/>
                                <Label fx:id="metricOpenIncidentsSub" text=""
                                       style="-fx-font-size:12px;-fx-text-fill:#C62828;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"
                          style="-fx-border-color:#C8E6C9;">
                        <padding><Insets top="22" right="22" bottom="20" left="22"/></padding>
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color:#DCFCE7;-fx-background-radius:14;
                                              -fx-min-width:62;-fx-min-height:62;-fx-max-width:62;-fx-max-height:62;">
                                <Label text="✔" style="-fx-font-size:30px;"/>
                            </StackPane>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Resolved (All Time)" styleClass="metric-label"/>
                                <Label fx:id="metricResolved" text="—"
                                       style="-fx-font-size:42px;-fx-font-weight:bold;-fx-text-fill:#2E7D32;"/>
                                <Label fx:id="metricResolvedSub" text=""
                                       style="-fx-font-size:12px;-fx-text-fill:#2E7D32;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"
                          style="-fx-border-color:#FFE0B2;">
                        <padding><Insets top="22" right="22" bottom="20" left="22"/></padding>
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color:#FFEDD5;-fx-background-radius:14;
                                              -fx-min-width:62;-fx-min-height:62;-fx-max-width:62;-fx-max-height:62;">
                                <Label text="📋" style="-fx-font-size:30px;"/>
                            </StackPane>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Pending Reports" styleClass="metric-label"/>
                                <Label fx:id="metricPending" text="—"
                                       style="-fx-font-size:42px;-fx-font-weight:bold;-fx-text-fill:#E65100;"/>
                                <Label fx:id="metricPendingSub" text=""
                                       style="-fx-font-size:12px;-fx-text-fill:#E65100;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- BOTTOM ROW -->
                <HBox spacing="16" VBox.vgrow="ALWAYS">

                    <!-- LEFT: Recent Registrations -->
                    <VBox HBox.hgrow="ALWAYS" spacing="12"
                          style="-fx-background-color:white;-fx-background-radius:12;
                                 -fx-border-color:#e8e8e8;-fx-border-radius:12;
                                 -fx-border-width:1;-fx-padding:18 18 18 18;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="👤" styleClass="panel-icon"/>
                            <Label text="Recent Registrations"
                                   styleClass="section-heading" HBox.hgrow="ALWAYS"/>
                            <Hyperlink text="View all" styleClass="view-all-link"
                                       onAction="#showResidents"/>
                        </HBox>
                        <TableView fx:id="dashRecentTable" styleClass="data-table"
                                   VBox.vgrow="ALWAYS"
                                   style="-fx-background-color:transparent;
                                          -fx-border-color:transparent;-fx-effect:none;">
                            <columns>
                                <TableColumn fx:id="dashColAvatar" text=""
                                             prefWidth="48" sortable="false" resizable="false"/>
                                <TableColumn fx:id="dashColName"    text="Name"            prefWidth="180"/>
                                <TableColumn fx:id="dashColAddress" text="Address"         prefWidth="160"/>
                                <TableColumn fx:id="dashColDate"    text="Date Registered" prefWidth="130"/>
                                <TableColumn fx:id="dashColStatus"  text="Status"          prefWidth="90"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- RIGHT COLUMN -->
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                style="-fx-background-color:transparent;-fx-background:transparent;
                                       -fx-border-color:transparent;"
                                minWidth="268" maxWidth="268" prefWidth="268">
                        <content>
                            <VBox spacing="14">

                                <!-- Incident Overview -->
                                <VBox styleClass="dash-panel" spacing="12">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <Label text="📊" styleClass="panel-icon"/>
                                        <Label text="Incident Overview" styleClass="section-heading"/>
                                    </HBox>
                                    <StackPane alignment="CENTER" minHeight="170">
                                        <Canvas fx:id="incidentDonut" width="170" height="170"/>
                                        <VBox alignment="CENTER" mouseTransparent="true">
                                            <Label fx:id="donutTotal" text="0"
                                                   styleClass="donut-center-value"/>
                                            <Label text="Total" styleClass="donut-center-label"/>
                                        </VBox>
                                    </StackPane>
                                    <VBox spacing="8">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label styleClass="legend-dot legend-dot-red" text="●"/>
                                            <Label text="Open" styleClass="legend-label" HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="legendOpen" text="0" styleClass="legend-count"/>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label styleClass="legend-dot legend-dot-orange" text="●"/>
                                            <Label text="Pending" styleClass="legend-label" HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="legendPending" text="0" styleClass="legend-count"/>
                                        </HBox>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label styleClass="legend-dot legend-dot-green" text="●"/>
                                            <Label text="Resolved" styleClass="legend-label" HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="legendResolved" text="0" styleClass="legend-count"/>
                                        </HBox>
                                    </VBox>
                                </VBox>

                                <!-- Quick Actions -->
                                <VBox styleClass="dash-panel" spacing="10">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <Label text="⚡" styleClass="panel-icon"/>
                                        <Label text="Quick Actions" styleClass="section-heading"/>
                                    </HBox>
                                    <Button text="➕  Add Resident" styleClass="quick-btn-primary"
                                            maxWidth="Infinity" onAction="#quickAddResident"/>
                                    <Button text="⚠  Report Incident" styleClass="quick-btn-danger"
                                            maxWidth="Infinity" onAction="#quickAddIncident"/>
                                </VBox>

                                <!-- Residents per Purok -->
                                <VBox styleClass="dash-panel" spacing="10">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <Label text="🏘" styleClass="panel-icon"/>
                                        <Label text="Residents per Purok"
                                               styleClass="section-heading" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <VBox fx:id="purokList" spacing="0">
                                        <!-- Purok 1 static placeholder row -->
                                        <HBox spacing="8" alignment="CENTER_LEFT"
                                              style="-fx-padding:8 2 8 2;
                                                     -fx-border-color:transparent transparent #F0F2F5 transparent;
                                                     -fx-border-width:0 0 1 0;">
                                            <Label text="Purok 1"
                                                   style="-fx-font-size:12px;-fx-font-weight:bold;
                                                          -fx-text-fill:#1B1F3B;" HBox.hgrow="ALWAYS"/>
                                            <Label text="— residents"
                                                   style="-fx-font-size:11px;-fx-font-weight:bold;
                                                          -fx-text-fill:#4A90D9;
                                                          -fx-background-color:#EFF6FF;
                                                          -fx-background-radius:10;
                                                          -fx-padding:2 8 2 8;"/>
                                        </HBox>
                                        <!-- Purok 2 static placeholder row -->
                                        <HBox spacing="8" alignment="CENTER_LEFT"
                                              style="-fx-padding:8 2 8 2;
                                                     -fx-border-color:transparent transparent #F0F2F5 transparent;
                                                     -fx-border-width:0 0 1 0;">
                                            <Label text="Purok 2"
                                                   style="-fx-font-size:12px;-fx-font-weight:bold;
                                                          -fx-text-fill:#1B1F3B;" HBox.hgrow="ALWAYS"/>
                                            <Label text="— residents"
                                                   style="-fx-font-size:11px;-fx-font-weight:bold;
                                                          -fx-text-fill:#7B68EE;
                                                          -fx-background-color:#F3F0FF;
                                                          -fx-background-radius:10;
                                                          -fx-padding:2 8 2 8;"/>
                                        </HBox>
                                        <!-- Purok 3 static placeholder row -->
                                        <HBox spacing="8" alignment="CENTER_LEFT"
                                              style="-fx-padding:8 2 8 2;">
                                            <Label text="Purok 3"
                                                   style="-fx-font-size:12px;-fx-font-weight:bold;
                                                          -fx-text-fill:#1B1F3B;" HBox.hgrow="ALWAYS"/>
                                            <Label text="— residents"
                                                   style="-fx-font-size:11px;-fx-font-weight:bold;
                                                          -fx-text-fill:#27AE60;
                                                          -fx-background-color:#F0FDF4;
                                                          -fx-background-radius:10;
                                                          -fx-padding:2 8 2 8;"/>
                                        </HBox>
                                    </VBox>
                                </VBox>

                            </VBox>
                        </content>
                    </ScrollPane>

                </HBox>
            </VBox>

            <!-- RESIDENTS -->
            <VBox fx:id="viewResidents" spacing="16" visible="false" managed="false">
                <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Residents" styleClass="page-title"/>
                        <Label fx:id="lblResidentCount" text="Loading..." styleClass="page-subtitle"/>
                    </VBox>
                    <TextField fx:id="txtSearch"
                               promptText="Search name, address, contact, status..."
                               styleClass="search-field" prefWidth="300"
                               onKeyReleased="#filterResidents"/>
                    <Button text="+ Add Resident" styleClass="btn-primary" onAction="#openAddModal"/>
                </HBox>
                <TableView fx:id="tableResidents" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName"      text="Name"      prefWidth="200"/>
                        <TableColumn fx:id="colAddress"   text="Address"   prefWidth="180"/>
                        <TableColumn fx:id="colBirthdate" text="Birthdate" prefWidth="110"/>
                        <TableColumn fx:id="colContact"   text="Contact"   prefWidth="130"/>
                        <TableColumn fx:id="colStatus"    text="Status"    prefWidth="90"/>
                        <TableColumn fx:id="colActions"   text=""          prefWidth="50"
                                     sortable="false" resizable="false"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- INCIDENTS -->
            <VBox fx:id="viewIncidents" spacing="16" visible="false" managed="false">
                <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Incidents" styleClass="page-title"/>
                        <Label fx:id="lblIncidentCount" text="Loading..." styleClass="page-subtitle"/>
                    </VBox>
                    <Button text="+ Report Incident" styleClass="btn-primary"
                            onAction="#openAddIncidentModal"/>
                </HBox>
                <TableView fx:id="tableIncidents" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="iColDesc"     text="Description" prefWidth="220"/>
                        <TableColumn fx:id="iColLocation" text="Location"    prefWidth="160"/>
                        <TableColumn fx:id="iColReporter" text="Reported by" prefWidth="160"/>
                        <TableColumn fx:id="iColStatus"   text="Status"      prefWidth="100"/>
                        <TableColumn fx:id="iColActions"  text=""            prefWidth="50"
                                     sortable="false" resizable="false"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- INVENTORY -->
            <VBox fx:id="viewInventory" spacing="16" visible="false" managed="false">
                <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Inventory" styleClass="page-title"/>
                        <Label fx:id="lblInventoryCount" text="Loading..." styleClass="page-subtitle"/>
                    </VBox>
                    <TextField fx:id="txtInventorySearch"
                               promptText="Search item, status, location..."
                               styleClass="search-field" prefWidth="260"
                               onKeyReleased="#filterInventory"/>
                    <Button text="+ Add Item" styleClass="btn-primary"
                            onAction="#openAddInventoryModal"/>
                </HBox>
                <HBox spacing="12">
                    <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                        <Label text="Stock summary" styleClass="metric-label"/>
                        <Label fx:id="lblInStock"    text="In Stock: —"    styleClass="inv-stat-good"/>
                        <Label fx:id="lblLowStock"   text="Low Stock: —"   styleClass="inv-stat-warn"/>
                        <Label fx:id="lblOutOfStock" text="Out of Stock: —" styleClass="inv-stat-bad"/>
                    </VBox>
                </HBox>
                <TableView fx:id="tableInventory" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="invColName"     text="Item Name"    prefWidth="200"/>
                        <TableColumn fx:id="invColQty"      text="Quantity"     prefWidth="90"/>
                        <TableColumn fx:id="invColStatus"   text="Stock Status" prefWidth="120"/>
                        <TableColumn fx:id="invColLocation" text="Location"     prefWidth="130"/>
                        <TableColumn fx:id="invColUpdated"  text="Last Updated" prefWidth="120"/>
                        <TableColumn fx:id="invColActions"  text=""             prefWidth="50"
                                     sortable="false" resizable="false"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- SETTINGS -->
            <VBox fx:id="viewSettings" spacing="20" visible="false" managed="false">
                <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
                <Label text="Settings" styleClass="page-title"/>
                <Label text="System configuration" styleClass="page-subtitle"/>
                <VBox styleClass="metric-card" spacing="14">
                    <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
                    <Label text="Change Admin Password" styleClass="section-heading"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Current password" styleClass="modal-label" minWidth="170"/>
                        <PasswordField fx:id="txtCurrentPass" promptText="Enter current password"
                                       styleClass="modal-field" prefWidth="260"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="New password" styleClass="modal-label" minWidth="170"/>
                        <PasswordField fx:id="txtNewPass" promptText="Enter new password"
                                       styleClass="modal-field" prefWidth="260"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Confirm password" styleClass="modal-label" minWidth="170"/>
                        <PasswordField fx:id="txtConfirmPass" promptText="Confirm new password"
                                       styleClass="modal-field" prefWidth="260"/>
                    </HBox>
                    <Label fx:id="lblSettingsMsg" text="" styleClass="error-label"
                           wrapText="true" visible="false" managed="false"/>
                    <HBox>
                        <Button text="Update Password" styleClass="btn-primary"
                                onAction="#handleChangePassword"/>
                    </HBox>
                </VBox>
                <VBox styleClass="metric-card" spacing="10">
                    <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
                    <Label text="System Information" styleClass="section-heading"/>
                    <HBox spacing="10">
                        <Label text="System:"     styleClass="modal-label" minWidth="170"/>
                        <Label text="Barangay Resident &amp; Incident System" styleClass="page-subtitle"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Version:"    styleClass="modal-label" minWidth="170"/>
                        <Label text="v1.1.0"      styleClass="page-subtitle"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Barangay:"   styleClass="modal-label" minWidth="170"/>
                        <Label text="Barangay 143, Olongapo City" styleClass="page-subtitle"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Compliance:" styleClass="modal-label" minWidth="170"/>
                        <Label text="DILG Compliant" styleClass="page-subtitle"/>
                    </HBox>
                </VBox>
            </VBox>

        </StackPane>
    </HBox>
</VBox>
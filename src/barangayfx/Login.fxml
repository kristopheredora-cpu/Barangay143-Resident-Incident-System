<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="barangayfx.LoginController"
           styleClass="login-root">

    <!-- BACKGROUND PHOTO -->
    <ImageView preserveRatio="false"
               fitWidth="1920" fitHeight="1080"
               mouseTransparent="true">
        <image><Image url="@bg.png"/></image>
    </ImageView>

    <!-- DARK OVERLAY -->
    <Pane styleClass="login-overlay" mouseTransparent="true"/>

    <!-- CENTERED LOGIN CARD — tight, no extra space -->
    <VBox styleClass="login-card"
          prefWidth="420" minWidth="420" maxWidth="420"
          alignment="TOP_CENTER" spacing="0"
          maxHeight="-Infinity">

        <!-- Header -->
        <VBox styleClass="login-header" alignment="CENTER" spacing="8" prefWidth="420">
            <padding><Insets top="22" bottom="18" left="24" right="24"/></padding>
            <ImageView fitWidth="100" fitHeight="100" preserveRatio="true">
                <image><Image url="@logo.png"/></image>
            </ImageView>
            <Label text="Barangay 143" styleClass="login-brgy-name"/>
            <Label text="Management System  ·  Admin Portal" styleClass="login-portal-label"/>
        </VBox>

        <!-- Form body — only what's needed -->
        <VBox spacing="12" style="-fx-background-color: white;">
            <padding><Insets top="22" right="28" bottom="22" left="28"/></padding>

            <Label text="Sign in to your account" styleClass="login-form-title"/>
            <Label text="Administrator access only" styleClass="login-form-subtitle"/>

            <VBox spacing="5">
                <Label text="Username" styleClass="login-field-label"/>
                <TextField fx:id="txtUsername"
                           promptText="Enter admin username"
                           styleClass="login-field"
                           onAction="#handleLogin"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Password" styleClass="login-field-label"/>
                <PasswordField fx:id="txtPassword"
                               promptText="Enter password"
                               styleClass="login-field"
                               onAction="#handleLogin"
                               visible="true" managed="true"/>
                <TextField fx:id="txtPasswordVisible"
                           promptText="Enter password"
                           styleClass="login-field"
                           onAction="#handleLogin"
                           visible="false" managed="false"/>
            </VBox>

            <CheckBox fx:id="chkShowPassword"
                      text="Show password"
                      styleClass="login-show-pass"
                      onAction="#togglePassword"/>

            <Label fx:id="lblError" text=""
                   styleClass="login-error"
                   wrapText="true"
                   visible="false" managed="false"/>

            <Button text="Sign In"
                    styleClass="btn-primary"
                    maxWidth="Infinity"
                    defaultButton="true"
                    onAction="#handleLogin">
                <VBox.margin><Insets top="2" bottom="4"/></VBox.margin>
            </Button>
        </VBox>

        <!-- Footer -->
        <VBox alignment="CENTER"
              style="-fx-background-color:white;-fx-background-radius:0 0 14 14;
                     -fx-border-color:#f0eeeb transparent transparent transparent;
                     -fx-border-width:1 0 0 0;">
            <padding><Insets top="10" bottom="14"/></padding>
            <Label text="Barangay 143, Olongapo City  ·  DILG Compliant  ·  v1.0"
                   styleClass="login-footer" maxWidth="Infinity"/>
        </VBox>

    </VBox>

</StackPane>